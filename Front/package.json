{
  "name": "autoloca-front",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "back": "cd ../Back && ./mvnw spring-boot:run",
    "back:windows": "cd ../Back && mvnw.cmd spring-boot:run",
    "dev:all": "concurrently --names BACK,FRONT --prefix-colors blue,green \"npm run back\" \"npm run dev\"",
    "dev:all:windows": "concurrently \"npm run back:windows\" \"npm run dev\"",
    "format": "prettier --write src vite.config.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "oxlint": "^1.25.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.12"
  }
}
